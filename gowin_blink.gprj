<?xml version="1" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW2AR-18C" pn="GW2AR-LV18QN88C8/I7">gw2ar18c-000</Device>
    <FileList>
        <File path="src/debounce.v" type="file.verilog" enable="1"/>
        <File path="src/debug_clock.v" type="file.verilog" enable="1"/>
        <File path="src/led.v" type="file.verilog" enable="1"/>
        <File path="src/led0.v" type="file.verilog" enable="0"/>
        <File path="src/uart_master/uart_master.v" type="file.verilog" enable="1"/>
        <File path="src/gowin_blink.cst" type="file.cst" enable="1"/>
        <File path="src/gowin_blink.sdc" type="file.sdc" enable="1"/>
        <File path="src/gowin_blink.rao" type="file.gao" enable="0"/>
        <File path="src/rs232.rao" type="file.gao" enable="1"/>
    </FileList>
</Project>
